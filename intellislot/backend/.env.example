# ====================================================================
# IntelliSlot Backend Environment Configuration Template
# Instructions: Copy this file to '.env' and fill in your actual values.
# NEVER commit the '.env' file to GitHub!
# ====================================================================

# Port for Express Server (Render/Railway sets PORT automatically)
PORT=5000

# Frontend URL for CORS (e.g., https://your-username.github.io or http://localhost:5500)
# Set to '*' during local development if needed
FRONTEND_URL=https://your-username.github.io

# MySQL Database Configuration (e.g. from Aiven, TiDB Cloud, Railway, or local XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=intellislot_db
DB_SSL=false

# If using Supabase (PostgreSQL), specify your connection string or use Supabase client:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key

# Node Environment
NODE_ENV=production
